  "license": "ISC",
  "description": "TypeDoc plugin to support FutureMachine interfaces.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/futuremachine-org/futuremachine.git",
    "directory": "packages/typedoc-plugin"
  },
  "bugs": {
    "url": "https://github.com/futuremachine-org/futuremachine/issues"
  },
  "homepage": "https://futuremachine.org",
  "keywords": [],
  "type": "module",
